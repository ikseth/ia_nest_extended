# Solo desarrollo local. No guardar credenciales ni endpoints internos.
IANEST_EXTENDED_CORE_URL=http://127.0.0.1:8000
# La REST de extended escucha solo en loopback por defecto. Cambiar REST_HOST
# expone memoria y conocimiento sin autenticacion; esa decision es explicita.
IANEST_EXTENDED_REST_HOST=127.0.0.1
IANEST_EXTENDED_REST_PORT=8001
IANEST_EXTENDED_OLLAMA_URL=http://127.0.0.1:11434
IANEST_EXTENDED_DATABASE_DSN=postgresql://ianest:ianest_local@127.0.0.1:55432/ianest_extended
IANEST_EXTENDED_EMBEDDING_MODEL=bge-m3
IANEST_EXTENDED_EMBEDDING_DIMENSION=1024
# ID existente en models[] de la config del core, NO un tag de Ollama.
# Consultar model.list; qwen_tech es solo un ejemplo de ID configurable.
IANEST_EXTENDED_EXTRACTION_MODEL=qwen_tech
IANEST_EXTENDED_TELEMETRY_DIR=telemetry/
# Identidad por defecto del CLI (deja de ser obligatoria en cada comando).
IANEST_EXTENDED_DEFAULT_USER_ID=local_operator
IANEST_EXTENDED_DEFAULT_SERVICE=local_cli
IANEST_EXTENDED_DEFAULT_NAMESPACE=
# Sesion recordada; contexto local, no se versiona. Por defecto,
# $XDG_STATE_HOME/ianest_extended/session_id
#IANEST_EXTENDED_SESSION_STATE_PATH=
# Override de sesion para hilos paralelos en terminales distintos. Precedencia:
# --session-id > IANEST_EXTENDED_SESSION_ID > fichero recordado.
#IANEST_EXTENDED_SESSION_ID=
# Defaults de enriquecimiento; las banderas del CLI hacen override.
IANEST_EXTENDED_ENRICH_ENABLED=true
IANEST_EXTENDED_MEMORY_ENABLED=true
IANEST_EXTENDED_WRITE_BACK_ENABLED=true
IANEST_EXTENDED_MEMORY_BUDGET_TOKENS=1500
IANEST_EXTENDED_DIALOG_TOP_K=6
IANEST_EXTENDED_EPISODIC_TOP_K=4
IANEST_EXTENDED_SEMANTIC_TOP_K=3
# Suelo de similitud de memoria (D4), solo para episodic (semantic, dialog y
# los delegados quedan fuera; ver docs/PLAN.md D4). Es PROVISIONAL y sin
# medida: 0.10 es conservador para no silenciar recuerdos pertinentes hasta
# calibrar junto a D5 con corpus y uso reales.
IANEST_EXTENDED_MEMORY_MIN_SIMILARITY=0.10
IANEST_EXTENDED_DEDUP_THRESHOLD=0.92
IANEST_EXTENDED_CONFIDENCE_THRESHOLD=0.7
# Timeout de CONEXION y timeout de INACTIVIDAD entre eventos (streaming).
IANEST_EXTENDED_CONNECT_TIMEOUT_SECONDS=30
IANEST_EXTENDED_INACTIVITY_TIMEOUT_SECONDS=30
# Plazo total de las operaciones bloqueantes de orquestacion task.plan/task.run.
IANEST_EXTENDED_TASK_TIMEOUT_SECONDS=600
# Segundos sin actividad del hilo; conserva el valor inicial de 4 horas.
IANEST_EXTENDED_SESSION_INACTIVITY_SECONDS=14400
IANEST_EXTENDED_PROMOTE_MIN_STABILITY=3
IANEST_EXTENDED_PROMOTE_MIN_SCORE=0.8
IANEST_EXTENDED_PROMOTE_RECENCY_MAX=0.1
# Sintesis de hilo (Fase 9). APAGADA por defecto: con ella apagada el
# comportamiento es el de siempre, y encenderla es lo que permite medir los dos
# brazos de su criterio. La ventana de 4 turnos es punto de partida medido -es
# donde aparecio el problema en laboratorio-, no una constante.
IANEST_EXTENDED_THREAD_SYNTHESIS_ENABLED=false
IANEST_EXTENDED_THREAD_SYNTHESIS_WINDOW_TURNS=4
# Modelo de apoyo para resumir (ADR 0006). Vacio toma el de extraccion.
#IANEST_EXTENDED_SYNTHESIS_MODEL=
IANEST_EXTENDED_RAG_ENABLED=true
IANEST_EXTENDED_RAG_TOP_K=3
# Suelo BASE de similitud (D1): un chunk por debajo no se devuelve aunque quede
# sitio en el top-k. D5 permite sobrescribirlo segun el dominio efectivo; si
# las claves especificas no se declaran, ambos regimenes conservan esta base.
IANEST_EXTENDED_RAG_MIN_SCORE=0.50
# Valores PROVISIONALES medidos el 2026-08-21 con 19 corpus, 57 chunks y
# bge-m3: con dominio 0.41; sin dominio 0.46. No son defaults portables. El
# estricto solo queda 0.002 por encima del ruido medido y ambos pierden 2/17
# consultas legitimas. Descomentar solo tras calibrar la instalacion.
#IANEST_EXTENDED_RAG_MIN_SCORE_DOMAIN=0.41
#IANEST_EXTENDED_RAG_MIN_SCORE_NO_DOMAIN=0.46
IANEST_EXTENDED_RAG_MAX_TOKENS=500
IANEST_EXTENDED_RAG_CHUNK_TOKENS=300
IANEST_EXTENDED_RAG_CHUNK_OVERLAP=0.15
# Resolucion automatica de dominio: gatea el conocimiento y rutea el modelo,
# por eso no lleva prefijo rag_.
IANEST_EXTENDED_AUTO_DOMAIN=false
IANEST_EXTENDED_AUTO_DOMAIN_MIN_CONFIDENCE=0.7
IANEST_EXTENDED_RAG_SUGGEST_MIN_CONFIDENCE=0.6
IANEST_EXTENDED_RAG_SUGGEST_SAMPLE_CHARS=2000

# DSN semilla para pytest: el fixture crea y usa <dbname>_test.
IANEST_EXTENDED_TEST_DSN=postgresql://ianest:ianest_local@127.0.0.1:55432/ianest_extended
